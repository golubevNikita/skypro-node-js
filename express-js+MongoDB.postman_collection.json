		{
			"name": "Просмотреть данные посетителя по его id",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Content-Type is correct\", function () {\r",
							"    pm.response.to.be.header(\"Content-Type\", \"application/json; charset=utf-8\");\r",
							"});\r",
							"\r",
							"pm.test(\"The response contains the object with required fields\", function() {\r",
							"    const visitor = pm.response.json();\r",
							"    \r",
							"    pm.expect(visitor).to.have.all.keys(\r",
							"        '_id',\r",
							"        'name',\r",
							"        'surname',\r",
							"        'email',\r",
							"        'borrowedBooks',\r",
							"        \"__v\"\r",
							"    );\r",
							"});\r",
							"\r",
							"pm.test(\"Request and response ids are equal\", function() {\r",
							"    const urlIdPart = pm.request.url.path;\r",
							"    const requestedVisitorId = urlIdPart[urlIdPart.length - 1];\r",
							"\r",
							"    const responseVisitorId = pm.response.json()._id;\r",
							"\r",
							"    pm.expect(requestedVisitorId).to.equal(responseVisitorId);\r",
							"});"
