		{
			"name": "Удаление посетителя из списков библиотеки",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"    pm.expect(pm.response.text()).to.include(\"Посетитель успешно удалён\");\r",
							"});\r",
							"\r",
							"pm.test(\"Content-Type is correct\", function () {\r",
							"    pm.response.to.be.header(\"Content-Type\", \"text/html; charset=utf-8\");\r",
							"});\r",
							"\r",
							"pm.test(\"Visitor is actually deleted\", function() {\r",
							"    const url = pm.environment.get(\"api_url\") + '/visitors'\r",
							"\r",
							"    const urlIdPart = pm.request.url.path;\r",
							"    const deletedVisitorId = urlIdPart[urlIdPart.length - 1];\r",
							"\r",
							"    if (pm.response.code === 200) {\r",
							"        pm.sendRequest({url, method: 'GET'}, function (err, visitorsResponse) {\r",
							"            if (err) {\r",
							"                pm.test(\"Request failed\", () => pm.expect.fail(err.message));\r",
							"                return;\r",
							"            }\r",
							"\r",
							"            const visitorsData = visitorsResponse.json().find((visitor) => visitor._id === deletedVisitorId);\r",
							"            pm.expect(visitorsData).to.be.undefined;\r",
							"        });\r",
							"    }\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
