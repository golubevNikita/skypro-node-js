				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"    pm.expect(pm.response.text()).to.include(\"Добавлен новый посетитель\");\r",
							"});\r",
							"\r",
							"pm.test(\"Content-Type is correct\", function () {\r",
							"    pm.response.to.be.header(\"Content-Type\", \"application/json\");\r",
							"});\r",
							"\r",
							"pm.test(\"The response contains the object with required fields\", function() {\r",
							"    const newVisitor = pm.response.json();\r",
							"    \r",
							"    pm.expect(newVisitor).to.have.all.keys(\r",
							"        'id',\r",
							"        'name',\r",
							"        'surname',\r",
							"        'email',\r",
							"        'borrowedBooks'\r",
							"    );\r",
							"});\r",
							"\r",
							"pm.test(\"The response matches request data\", function() {\r",
							"    const requestBody = JSON.parse(pm.request.body.raw);\r",
							"    const responseData = pm.response.json();\r",
							"    \r",
							"    pm.expect(responseData.name).to.equal(requestBody.name);\r",
							"    pm.expect(responseData.surname).to.equal(requestBody.surname);\r",
							"    pm.expect(responseData.email).to.equal(requestBody.email);\r",
							"});\r",
							"\r",
							"pm.test(\"The request body has required fields\", function() {\r",
							"    const requestData = JSON.parse(pm.request.body.raw);\r",
							"    \r",
							"\r",
							"    pm.expect(requestData).to.have.keys([\r",
							"        'name',\r",
							"        'surname',\r",
							"        'email'\r",
							"    ]);\r",
							"    \r",
							"    pm.expect(requestData.name).to.not.be.empty;\r",
							"    pm.expect(requestData.surname).to.not.be.empty;\r",
							"    pm.expect(requestData.email).to.not.be.empty;\r",
