		{
			"name": "Выдать книгу",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Content-Type is correct\", function () {\r",
							"    pm.response.to.be.header(\"Content-Type\", \"application/json\");\r",
							"});\r",
							"\r",
							"pm.test(\"The response contains the object with required fields\", function() {\r",
							"    const responseData = pm.response.json();\r",
							"\r",
							"    pm.expect(responseData).to.have.all.keys(\r",
							"        'id',\r",
							"        'name',\r",
							"        'surname',\r",
							"        'email',\r",
							"        'borrowedBooks'\r",
							"    );\r",
							"    \r",
							"    const borrowedBookId = parseInt(pm.request.url.split('/').at(-1));\r",
							"    pm.expect(responseData.borrowedBooks).to.include(borrowedBookId);\r",
							"});\r",
							"\r",
							"pm.test(\"Book is now unavailable\", function() {\r",
							"    const url = pm.environment.get(\"api_url\") + '/books'\r",
							"    const bookId = parseInt(pm.request.url.split('/').at(-1));\r",
							"\r",
							"    pm.sendRequest({url, method: 'GET'}, function (err, bookResponse) {\r",
							"        if (err) {\r",
							"            pm.test(\"Request failed\", () => pm.expect.fail(err.message));\r",
							"            return;\r",
							"        }\r",
							"\r",
							"        const bookData = bookResponse.json().find((book) => book.id === bookId);\r",
							"        pm.expect(bookData.length).to.equal(0);\r",
							"    });\r",
							"});\r",
							"\r",
							"pm.test(\"Request and response ids are equal\", function() {\r",
							"    const requestedVisitorId = pm.request.url.split('/').at(-3);\r",
							"    const responseVisitorId = pm.response.json();\r",
							"    \r",
							"    pm.expect(requestedVisitorId).to.equal(responseVisitorId.id);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
